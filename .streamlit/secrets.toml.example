# Modèle de configuration des secrets.
#
# COPIEZ ce fichier en `.streamlit/secrets.toml` puis renseignez la valeur.
# `.streamlit/secrets.toml` est exclu du dépôt par .gitignore : il ne sera
# jamais poussé sur GitHub.
#
# Sans ce fichier, l'application utilise SQLite en local (data/factures.db).

[postgres]
# Chaîne de connexion Postgres du projet Supabase.
#
# Où la trouver : tableau de bord Supabase > bouton « Connect » (en haut) >
# onglet « ORMs » ou « Connection string » > mode « Transaction pooler ».
# Remplacez [YOUR-PASSWORD] par le mot de passe de la base choisi à la création
# du projet (réinitialisable dans Settings > Database > Reset database password).
#
# Elle ressemble à :
#   postgresql://postgres.zmjorjniliehxeiqtjzy:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#
# Préférez le « Transaction pooler » (port 6543) au port 5432 : il supporte
# mieux les connexions courtes d'une application web.
url = "postgresql://postgres.zmjorjniliehxeiqtjzy:MOT_DE_PASSE@HOTE.pooler.supabase.com:6543/postgres"
